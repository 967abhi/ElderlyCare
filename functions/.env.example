# Only for running the functions locally. On GCP these come from --set-env-vars / --set-secrets.
MONGO_URI=
# MONGO_DB_NAME=          # only if your API uses a database name different from the one in MONGO_URI

# Leave SMTP_HOST empty to log emails instead of sending them
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ElderlyCare <no-reply@example.com>
TIMEZONE=Asia/Kolkata
