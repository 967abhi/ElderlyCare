# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000

# MongoDB Atlas connection string
MONGO_URI=

# JWT for /api/v1 (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=1d

# JWT secrets for the old (legacy) endpoints
USER_JWT_SECRET=
CARETAKER_JWT_SECRET=

# Comma-separated frontend URLs allowed by CORS (empty = allow any origin, dev only)
CLIENT_URL=

# Pub/Sub. Leave PUBSUB_BOOKING_TOPIC empty to run without GCP (events are only logged).
GCP_PROJECT_ID=
PUBSUB_BOOKING_TOPIC=
# PUBSUB_EMULATOR_HOST=localhost:8085
# GOOGLE_APPLICATION_CREDENTIALS=./sa-key.json

# Optional: protects POST /internal/outbox/flush (used by Cloud Scheduler)
OUTBOX_FLUSH_TOKEN=
